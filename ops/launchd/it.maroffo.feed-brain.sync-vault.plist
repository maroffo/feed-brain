<?xml version="1.0" encoding="UTF-8"?>
<!-- ABOUTME: launchd agent that runs `feed-brain sync-vault` hourly and at login (vault outbox → Obsidian). -->
<!-- ABOUTME: Install: cp to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <plist>`; needs gcloud ADC. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>it.maroffo.feed-brain.sync-vault</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>/Users/maroffo/Development/private/feed-brain</string>
    <string>feed-brain</string>
    <string>sync-vault</string>
  </array>
  <!-- .env in the project dir provides DATA_BUCKET and VAULT_PATH -->
  <key>WorkingDirectory</key>
  <string>/Users/maroffo/Development/private/feed-brain</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/maroffo/Library/Logs/feed-brain-sync-vault.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/maroffo/Library/Logs/feed-brain-sync-vault.log</string>
</dict>
</plist>
