# ABOUTME: Example environment for local development; copy to .env and fill in.
# ABOUTME: In Cloud Run the same variables come from the job spec and Secret Manager.

# Anthropic API key (Opus deep analysis on top stories)
ANTHROPIC_API_KEY=sk-ant-xxx
# ANALYZER_EFFORT=high

# Gemini (triage, clustering, writing)
GEMINI_API_KEY=xxx
# GEMINI_MODEL=gemini-3.8-flash

# Postgres (docker compose up -d db)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=feedbrain
DB_USER=feedbrain
DB_PASSWORD=feedbrain

# Logging
# LOG_LEVEL=INFO

# Proxy for sites that block cloud IPs (one retry on 403/419/429)
# FETCH_PROXY=socks5://user:pass@host:1080

# Newsletter inbox (optional): read the S3 bucket with a local AWS profile
# INBOX_BUCKET=feed-brain-inbox-<account-id>
# INBOX_REGION=eu-west-1
# AWS_PROFILE=<profile of the account that owns the SES domain>
